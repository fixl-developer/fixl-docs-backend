NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
STORAGE_BUCKET=reports
FRONTEND_URL=http://localhost:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy snippet endpoint only; use a randomly generated secret.
IP_HASH_SALT=
# Legacy artifact renderer only; not used by the redesigned UI.
BROWSERLESS_API_KEY=

# Read-only GitHub App user authorization. Never use NEXT_PUBLIC_ for these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters; protects stored user tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=
